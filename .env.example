# Apache Pulsar — single-node standalone broker (broker + ZooKeeper + BookKeeper)
#
# Ports (bound on 0.0.0.0):
#   8080  web/admin HTTP   (PRIMARY — public L7 URL, health, build probe)
#   6650  pulsar://        (data plane — enable public TCP for external clients)
#   9091  pulsar+ws://     (WebSocket data plane)
#   2181  ZooKeeper        (in-broker)
#   3181  BookKeeper

# Host the broker advertises to clients (the destination of pulsar://:6650).
#   external / internet clients -> the public domain (default) or the L4 TCP-proxy domain
#   same-project services        -> ${RAILWAY_PRIVATE_DOMAIN}  (zero egress, preferred internally)
PULSAR_ADVERTISED_ADDRESS=${RAILWAY_PUBLIC_DOMAIN}

# Data directory (BookKeeper ledgers + ZooKeeper metadata) on the attached persistent volume.
# Keep the volume mounted here or every restart rebuilds the broker and all data is wiped.
PULSAR_DATA=/pulsar/data
